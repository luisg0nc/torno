{
  "name": "torno-app",
  "productName": "torno",
  "private": true,
  "version": "0.0.0",
  "description": "Desktop workbench for making CAD parts with an AI coding agent",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/build-viewer.mjs",
    "postinstall": "node scripts/node-pty-exec.mjs",
    "dist:mac": "electron-vite build && node scripts/build-viewer.mjs && electron-builder --mac",
    "pack:check": "electron-vite build && node scripts/build-viewer.mjs && electron-builder --linux dir",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:kernel": "vitest run --mode kernel --passWithNoTests",
    "test:e2e": "electron-vite build && node scripts/build-viewer.mjs && playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chokidar": "^5.0.0",
    "node-pty": "^1.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.7.0",
    "electron-builder": "26.17.0",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
