#!/bin/sh
# Start torno: scripts/torno [workspace]
#
# Works from any directory. Installs the dependencies if they are missing,
# builds the app if it has not been built since its sources changed, then starts
# Electron on it. A folder given as the argument is opened as the workspace;
# with none, torno opens the one it was last pointed at.
#
# TORNO_OZONE=wayland or x11 has Electron told which platform to draw on;
# unset, Electron chooses. (On macOS Electron has one platform: it is ignored.) --print-command says what would be started and
# starts nothing. --print-desktop prints a desktop entry for this script,
# --install-desktop writes it, --uninstall-desktop removes it: that one file,
# under the person's data folder, is all this script ever writes outside the
# repository, and only when it is asked to by that option. Desktop entries are
# Linux's: on macOS those three options write nothing and exit 2.
#
# --from-desktop is how the desktop entry starts it: nobody reads what a launcher prints, so what goes wrong is
# then also shown as a notice (notify-send, where there is one) or, failing that, written to
# ${XDG_STATE_HOME:-~/.local/state}/torno/launcher.log.
set -eu

# The repository is the parent of this file's folder, also when called through a symlink.
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
# Read once: macOS has no desktop entries and one Electron platform.
darwin=
[ "$(uname -s)" != Darwin ] || darwin=1
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd -P)
app=$root/app

# Says what went wrong: on stderr, and for a start from the desktop entry also where it will be seen.
from_desktop=
complain() {
  echo "torno: $1" >&2
  [ -n "$from_desktop" ] || return 0
  notifier=${TORNO_NOTIFY:-notify-send}
  if command -v "$notifier" >/dev/null 2>&1 && "$notifier" torno "$1" 2>/dev/null; then
    return 0
  fi
  case ${XDG_STATE_HOME-} in
    /*) state=$XDG_STATE_HOME ;;
    *) state=${HOME:+$HOME/.local/state} ;;
  esac
  [ -n "$state" ] || return 0
  mkdir -p -- "$state/torno" 2>/dev/null || return 0
  printf '%s torno: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >>"$state/torno/launcher.log" 2>/dev/null || true
}
if [ "${1-}" = --from-desktop ]; then
  from_desktop=1
  shift
fi

usage() {
  echo "usage: torno [workspace]"
  echo "       torno --print-command [workspace]"
  echo "       torno --print-desktop | --install-desktop | --uninstall-desktop"
  echo "  workspace            a folder of objects to open (default: the one opened last)"
  echo "  --print-command      print the command that would be started, one argument a line, and start nothing"
  echo "  --print-desktop      Linux only: print the desktop entry for this script, and write nothing"
  echo "  --install-desktop    Linux only: write that entry to \${XDG_DATA_HOME:-~/.local/share}/applications/torno.desktop"
  echo "  --uninstall-desktop  Linux only: remove it (on macOS the three are refused: make torno.app with pnpm dist:mac)"
  echo "  --from-desktop       first, as the desktop entry gives it: errors are also shown as a notice, or logged"
  echo "  TORNO_OZONE          Linux only: wayland or x11, the platform Electron is told to draw on (default: Electron chooses; ignored on macOS)"
}

# How it is used, whatever else is asked or set: the help is where TORNO_OZONE is explained.
case ${1-} in
  -h | --help)
    usage
    exit 0
    ;;
esac

# The platform is passed on only when it is asked for by name. Read before anything is checked, installed,
# built or written. Never headless: Electron crashes with it here. And none at all under TORNO_TEST=1.
ozone=
case ${TORNO_OZONE-} in
  '') ;;
  wayland | x11)
    if [ -n "$darwin" ]; then
      [ "${TORNO_TEST-}" = 1 ] || echo "torno: TORNO_OZONE is for Linux; on macOS Electron has one platform, and it is ignored" >&2
    else
      [ "${TORNO_TEST-}" = 1 ] || ozone=--ozone-platform=$TORNO_OZONE
    fi
    ;;
  *)
    complain "TORNO_OZONE must be wayland or x11 (headless is not supported: Electron crashes with it here)"
    exit 2
    ;;
esac

# The desktop entry, from scripts/torno.desktop.in: @EXEC@ is this script and @ICON@ the icon beside it, both
# by their whole paths, so nothing but the entry is installed. It names no platform: this script decides that
# when it is started, from TORNO_OZONE.
desktop_entry() {
  case $root in
    *"
"*)
      echo "torno: the repository's path holds a line break: a desktop entry cannot name it" >&2
      return 2
      ;;
  esac
  # Exec: the path in double quotes with the four characters the Desktop Entry Specification names escaped,
  # then every backslash doubled as in any string of the file, and a per cent doubled, which is else a field code.
  exec_path=$(printf '%s' "$root/scripts/torno" | sed -e 's/[\\"`$]/\\&/g' -e 's/\\/\\\\/g' -e 's/%/%%/g')
  icon_path=$(printf '%s' "$root/scripts/torno.svg" | sed -e 's/\\/\\\\/g')
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      *@EXEC@*) printf '%s"%s" --from-desktop%s\n' "${line%%@EXEC@*}" "$exec_path" "${line#*@EXEC@}" ;;
      *@ICON@*) printf '%s%s%s\n' "${line%%@ICON@*}" "$icon_path" "${line#*@ICON@}" ;;
      *) printf '%s\n' "$line" ;;
    esac
  done <"$root/scripts/torno.desktop.in"
}

print_only=
case ${1-} in
  -h | --help)
    usage
    exit 0
    ;;
  --print-command)
    print_only=1
    shift
    ;;
  --print-desktop | --install-desktop | --uninstall-desktop)
    if [ -n "$darwin" ]; then
      echo "torno: desktop entries are for Linux; on macOS make torno.app with pnpm dist:mac (README, Run)" >&2
      exit 2
    fi
    if [ $# -gt 1 ]; then
      echo "torno: $1 takes nothing after it" >&2
      exit 2
    fi
    if [ "$1" = --print-desktop ]; then
      desktop_entry
      exit
    fi
    # Where the person's applications are listed. Never the system's, and never as root: this is one person's launcher.
    if [ "$(id -u)" = 0 ]; then
      echo "torno: $1 is for your own account, not as root" >&2
      exit 2
    fi
    # A data folder that is not a whole path is no data folder (the specification says to pass over it).
    case ${XDG_DATA_HOME-} in
      /*) data=$XDG_DATA_HOME ;;
      *) data= ;;
    esac
    if [ -n "$data" ]; then
      :
    elif [ -n "${HOME-}" ]; then
      data=$HOME/.local/share
    else
      echo "torno: neither XDG_DATA_HOME nor HOME is set: there is nowhere to keep a desktop entry" >&2
      exit 2
    fi
    entry=$data/applications/torno.desktop
    if [ "$1" = --uninstall-desktop ]; then
      rm -f -- "$entry"
      echo "torno: removed $entry"
      exit 0
    fi
    text=$(desktop_entry)
    # Said before it is done: the one file, and what goes into it.
    if [ -e "$entry" ] || [ -L "$entry" ]; then
      echo "torno: replacing $entry"
    else
      echo "torno: writing $entry"
    fi
    printf '%s\n' "$text"
    mkdir -p -- "$data/applications"
    printf '%s\n' "$text" >"$entry"
    echo "torno: wrote $entry"
    echo "Run it again after moving the repository."
    exit 0
    ;;
esac
if [ $# -gt 1 ]; then
  complain "expected at most one argument, a workspace folder"
  exit 2
fi
workspace_given=0
if [ $# -eq 1 ]; then
  workspace_given=1
  if [ ! -d "$1" ]; then
    complain "not a folder: $1"
    exit 2
  fi
  TORNO_WORKSPACE=$(CDPATH= cd -- "$1" && pwd -P)
  export TORNO_WORKSPACE
fi

# The command, made once: what --print-command prints is what is started. The workspace is not an argument of
# it: it goes in the environment, as TORNO_WORKSPACE.
set -- "$app/node_modules/.bin/electron" "$app"
[ -z "$ozone" ] || set -- "$@" "$ozone"
if [ -n "$print_only" ]; then
  # All of what is started: the folder goes in the environment, and is said first when there is one.
  [ -z "${TORNO_WORKSPACE-}" ] || [ $workspace_given = 0 ] || printf 'TORNO_WORKSPACE=%s\n' "$TORNO_WORKSPACE"
  printf '%s\n' "$@"
  exit 0
fi

for tool in node pnpm uv; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    complain "'$tool' was not found on PATH (see README.md, Requirements)"
    exit 1
  fi
done

if [ ! -d "$root/node_modules" ] || [ ! -d "$app/node_modules" ]; then
  echo "torno: installing dependencies" >&2
  (cd "$root" && pnpm install) >&2 || {
    complain "installing the dependencies failed: run scripts/torno in a terminal to see why"
    exit 1
  }
fi

# Built once, and again whenever what a source, the build's own configuration or one of its scripts (the viewer
# of exported pages is bundled by app/scripts) holds is other than at the last build that succeeded. The stamp
# is a hash of those files, their paths and their contents, not a time: a checkout or a touch that leaves every
# one as it was builds nothing, and any change of one, a file added, removed or renamed among them, builds
# again. The build's own files will not do as a stamp, since the main bundle is written before the renderer is
# compiled, and a build that then fails would leave it looking fresh. Tests and notes are not built.
# The hash tool, chosen once: sha256sum (GNU), else shasum (macOS, in /usr/bin). Both print `<hash>  <name>`.
if command -v sha256sum >/dev/null 2>&1; then
  sha256=sha256sum
elif command -v shasum >/dev/null 2>&1; then
  sha256='shasum -a 256'
else
  complain "neither sha256sum nor shasum was found on PATH"
  exit 1
fi
sources() {
  (cd "$root" && find app/src app/scripts app/package.json app/electron.vite.config.ts app/tsconfig.json pnpm-lock.yaml \
    -type f ! -name '*.test.ts' ! -name '*.test.tsx' ! -name '*.itest.ts' ! -name 'CLAUDE.md' -print0 |
    LC_ALL=C sort -z | xargs -0 $sha256 | $sha256 | cut -d ' ' -f 1)
}
stamp=$app/out/.built
held=$(sources)
if [ ! -f "$stamp" ] || [ ! -f "$app/out/main/index.js" ] || [ ! -f "$app/out/preload/index.js" ] || [ ! -f "$app/out/renderer/index.html" ] || [ ! -f "$app/out/viewer/viewer.js" ] ||
  [ "$(cat "$stamp")" != "$held" ]; then
  echo "torno: building the app" >&2
  # The stamp is of what the sources held when the build began: one saved while it ran is a change.
  (cd "$root" && pnpm build) >&2 || {
    complain "building the app failed: run scripts/torno in a terminal to see why"
    exit 1
  }
  printf '%s\n' "$held" >"$stamp.tmp" && mv -f -- "$stamp.tmp" "$stamp"
fi

exec "$@"
